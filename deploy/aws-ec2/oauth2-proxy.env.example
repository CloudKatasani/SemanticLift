# Copy to oauth2-proxy.env and fill in from your identity provider (Microsoft Entra ID, Okta, Amazon Cognito, Google ...).
# Register a web application with redirect URI https://<your-host>/oauth2/callback.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OAUTH2_PROXY_CLIENT_ID=<client-id>
OAUTH2_PROXY_CLIENT_SECRET=<client-secret>
OAUTH2_PROXY_REDIRECT_URL=https://semanticlift.example.com/oauth2/callback
# 32 random bytes, URL-safe base64: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=<generated>
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_SCOPE=openid email profile
# Group membership becomes X-Forwarded-Groups; map those groups to roles in users.yaml (groups: section).
# The claim name depends on the provider (Entra ID and Okta: groups).
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
