# Copy to caddy.env and edit. Read by docker compose.

# The public host name. With sslip.io it is the instance's Elastic IP with dashes, plus .sslip.io:
#   Elastic IP 3.121.45.67  ->  SITE_HOST=3-121-45-67.sslip.io
SITE_HOST=3-121-45-67.sslip.io

# Where Caddy sends requests:
#   semanticlift:8000   the app directly (no sign-in, or personal tokens)
#   oauth2-proxy:4180   single sign-on (docker compose --profile sso)
UPSTREAM=semanticlift:8000
