# Copy to semanticlift.env (same folder) and edit. Read by docker compose; never commit the real file.

SEMLIFT_ENV=production
SEMLIFT_HOME=/data/home
SEMLIFT_CONFIG_DIR=/app/config

# --- sign-in: choose ONE -------------------------------------------------------------------
# a) Personal tokens (create hashes with: docker compose run --rm semanticlift semlift token)
SEMLIFT_USERS_FILE=/data/users.yaml
# b) Single sign-on through oauth2-proxy (docker compose --profile sso). Keep the users file for group -> role mapping.
# SEMLIFT_TRUST_PROXY_HEADERS=1
# c) One shared administrator token (automation only)
# SEMLIFT_API_TOKEN=change-me

# --- capacity ---------------------------------------------------------------------------------
SEMLIFT_MAX_CONCURRENT_RUNS=2

# --- optional live Snowflake checks -----------------------------------------------------------
# The connector currently signs in with the browser-based "externalbrowser" authenticator, which cannot work on a
# headless server. Leave these unset on EC2; compile checks and parity runs belong in the CI pipeline.
# SEMLIFT_SNOWFLAKE_ACCOUNT=
# SEMLIFT_SNOWFLAKE_USER=
# SEMLIFT_SNOWFLAKE_ROLE=
# SEMLIFT_SNOWFLAKE_WAREHOUSE=
# SEMLIFT_SNOWFLAKE_DATABASE=
